{
  "name": "kallosmd",
  "description": "Free online Markdown editor with live preview, LaTeX math (KaTeX), Mermaid diagrams, and PDF/HTML export. Local-first and private.",
  "keywords": [
    "markdown",
    "markdown-editor",
    "live-preview",
    "wysiwyg",
    "katex",
    "latex",
    "mermaid",
    "markdown-to-pdf",
    "codemirror",
    "svelte",
    "local-first",
    "offline",
    "privacy",
    "kallos",
    "kallosmd"
  ],
  "homepage": "https://kallosmd.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamaelEND/kallosmd.git"
  },
  "bugs": {
    "url": "https://github.com/SamaelEND/kallosmd/issues"
  },
  "license": "AGPL-3.0-only",
  "author": "Manuel Alvarez",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "node --import ./scripts/ts-loader.mjs --test tests/*.test.ts",
    "seo:check": "node scripts/seo-check.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/dompurify": "^3.0.5",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.19.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@replit/codemirror-minimap": "^0.5.2",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "idb": "^8.0.4",
    "katex": "^0.19.1",
    "lucide-svelte": "^1.0.1",
    "marked": "^18.1.2",
    "mermaid": "^12.2.0"
  }
}
